# Secrets for scripts/35_publish.py --live --upload. Copy this file to .secrets\publish.env on the PC and fill it in.
# .secrets/ is gitignored: never commit the filled-in copy. Variables already set in Windows take precedence.

# Cloudflare R2 (dashboard > R2 > Manage API tokens: "Object Read & Write" on this bucket only)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dustahead-live

# Healthchecks.io check with a 10-minute period and a 15-minute grace (pages the team when runs stop)
DUSTAHEAD_HC_URL=https://hc-ping.com/<uuid>
